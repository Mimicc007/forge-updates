{
  "name": "forge",
  "version": "0.2.0-alpha",
  "private": true,
  "type": "module",
  "author": "Forge Team",
  "description": "Forge Universal Knowledge System",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"npm run dev\" \"cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "package": "npm run build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "devDependencies": {
    "agentation": "^3.0.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "idb": "^8.0.3",
    "lucide": "^1.17.0",
    "quill": "^2.0.3"
  },
  "build": {
    "appId": "com.forge.app",
    "productName": "Forge",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
